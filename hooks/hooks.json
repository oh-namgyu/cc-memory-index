{
  "description": "Rebuild the memory index after Claude writes a memory file (only in stores cc-memory-index has already written).",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run_hook.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
